{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/casestudy",
      "destination": "/#work",
      "permanent": false
    },
    {
      "source": "/casestudy/(.*)",
      "destination": "/#work",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/shell"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(covers|thumbs|images)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
